---
const title = "Building Performance & Environmental Simulation";
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Sayali Lamne</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Raleway', sans-serif; background: #fff; color: #111; }

    .back { display: inline-block; margin: 40px 5%; font-size: 14px; color: #db634c; text-decoration: none; letter-spacing: 0.05em; }
    .back:hover { text-decoration: underline; }

    .hero { padding: 80px 5% 100px; }
    .index { font-size: 13px; font-weight: 500; color: #db634c; font-family: system-ui, sans-serif; margin-bottom: 24px; }
    h1 { font-size: clamp(36px, 6vw, 72px); font-weight: 600; line-height: 1.1; letter-spacing: -0.5px; max-width: 800px; }

    /* ---- Sub-projects section ---- */
    .subprojects-section {
      padding: 0 5% 120px;
    }
    .subprojects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 28px;
    }

    /* Cards — identical to homepage .cat-card pattern */
    .cat-card {
      display: flex;
      flex-direction: column;
      background: transparent;
      border: none;
      text-align: left;
      cursor: pointer;
      text-decoration: none;
    }
    .cat-card__top {
      position: relative;
      padding-left: 28px;
    }
    .cat-card__index {
      position: absolute;
      bottom: 0;
      left: 0;
      font-family: system-ui, sans-serif;
      font-weight: 500;
      font-size: 13px;
      line-height: 1;
      color: #db634c;
    }
    .cat-card__media {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 3;
      background-color: #f2f2f2;
      overflow: hidden;
    }
    .cat-card__fill {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: #f2f2f2;
      background-size: cover;
      background-position: center;
      transform: scale(1);
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cat-card__text {
      padding-top: 14px;
    }
    .cat-card__subheading {
      font-family: 'Raleway', sans-serif;
      font-weight: 500;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #db634c;
      margin: 0 0 6px;
    }
    .cat-card__title {
      font-family: 'Raleway', sans-serif;
      font-weight: 600;
      font-size: 18px;
      line-height: 1.3;
      color: #111111;
      margin: 0;
    }
    .cat-card__title,
    .cat-card__subheading {
      transition: color 0.3s ease, font-size 0.3s ease;
    }
    .cat-card:hover .cat-card__fill,
    .cat-card.is-active .cat-card__fill {
      transform: scale(1.1);
    }
    .cat-card:hover .cat-card__title,
    .cat-card.is-active .cat-card__title {
      color: #db634c;
      font-size: 20px;
    }

    /* Scroll-reveal */
    .reveal {
      opacity: 0;
      transform: translateY(60px);
      transition:
        opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    /* Responsive */
    @media (max-width: 880px) {
      .subprojects-grid { grid-template-columns: repeat(2, 1fr); gap: 44px 36px; }
    }
    @media (max-width: 560px) {
      .subprojects-grid { grid-template-columns: 1fr; gap: 40px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; transition: none; }
      .cat-card__fill { transition: none; }
    }
  </style>
</head>
<body>
  <a class="back" href="/#projects">← Back to Projects</a>

  <div class="hero">
    <p class="index">04</p>
    <h1>{title}</h1>
  </div>

  <section class="subprojects-section">
    <div class="subprojects-grid">
        <a class="cat-card reveal" href="/projects/daylight-modeling" aria-pressed="false">
          <div class="cat-card__top">
            <span class="cat-card__index">01</span>
            <div class="cat-card__media"><span class="cat-card__fill" style="background-image: url('/2. Shaping Daylight through Simulation/Part-2 (Spatial Dayalight Analysis)/2.jpg');"></span></div>
          </div>
          <div class="cat-card__text">
            <p class="cat-card__subheading">Daylight Modeling</p>
            <h3 class="cat-card__title">Shaping Daylight Through Simulation and Virtual Reality</h3>
          </div>
        </a>

        <a class="cat-card reveal" href="/projects/energy-modeling" aria-pressed="false">
          <div class="cat-card__top">
            <span class="cat-card__index">02</span>
            <div class="cat-card__media"><span class="cat-card__fill" style="background-image: url('/3. Environmnetal Performance Analysis/Hero image.png'); background-size: contain; background-repeat: no-repeat; background-color: #ffffff;"></span></div>
          </div>
          <div class="cat-card__text">
            <p class="cat-card__subheading">Energy Modeling</p>
            <h3 class="cat-card__title">Environmental Performance Simulation</h3>
          </div>
        </a>

        <a class="cat-card reveal" href="/projects/building-performance-modeling" aria-pressed="false">
          <div class="cat-card__top">
            <span class="cat-card__index">03</span>
            <div class="cat-card__media"><span class="cat-card__fill" style="background-image: url('/4. Building Performance/Carnegie-Mellon-University-Ansys-Hall-996x554-1 (1).jpg'); background-position: center 20%;"></span></div>
          </div>
          <div class="cat-card__text">
            <p class="cat-card__subheading">Application of Energy Modeling</p>
            <h3 class="cat-card__title">Building Performance Modeling (BPM)</h3>
          </div>
        </a>

        <a class="cat-card reveal" href="/projects/passive-strategies" aria-pressed="false">
          <div class="cat-card__top">
            <span class="cat-card__index">04</span>
            <div class="cat-card__media"><span class="cat-card__fill" style="background-image: url('/passive-house-1.png'); background-size: cover; background-position: center 40%;"></span></div>
          </div>
          <div class="cat-card__text">
            <p class="cat-card__subheading">Application of Passive Design Strategies & Energy Modeling</p>
            <h3 class="cat-card__title">Passive Strategies for a Sustainable House</h3>
          </div>
        </a>
    </div>
  </section>

  <script is:inline>
    (function () {
      // Scroll-reveal
      const items = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
        );
        items.forEach((el, i) => {
          el.style.transitionDelay = Math.min(i * 80, 320) + 'ms';
          io.observe(el);
        });
      }

      // Single-select active state (mirrors homepage behavior)
      const cards = document.querySelectorAll('.cat-card');
      function selectCard(card) {
        const wasActive = card.classList.contains('is-active');
        cards.forEach((c) => {
          c.classList.remove('is-active');
          c.setAttribute('aria-pressed', 'false');
        });
        if (!wasActive) {
          card.classList.add('is-active');
          card.setAttribute('aria-pressed', 'true');
        }
      }
      cards.forEach((card) => {
        card.addEventListener('click', (e) => {
          // Only prevent navigation on second click (deselect), allow on first
          if (!card.classList.contains('is-active')) {
            selectCard(card);
          }
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
            e.preventDefault();
            selectCard(card);
          }
        });
      });
    })();
  </script>
</body>
</html>
