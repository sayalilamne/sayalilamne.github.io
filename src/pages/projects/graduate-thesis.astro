<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Graduate Thesis — Sayali Lamne</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Raleway', sans-serif;
      background: #ffffff;
      color: #111111;
      line-height: 1.6;
    }

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 80px;
      padding: 24px 130px 24px 70px;
      box-sizing: border-box;
    }
    .nav-logo {
      font-size: 18px;
      font-weight: 700;
      color: #111;
      text-decoration: none;
      letter-spacing: 0.05em;
    }
    .nav-links {
      display: flex;
      gap: 24px;
      margin-left: auto;
    }
    .nav a {
      font-size: 18px;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: #111;
      text-decoration: none;
    }
    .nav a:hover { color: #db634c; }
    .back {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 400;
      color: #333;
      text-decoration: none;
      letter-spacing: 0.02em;
      border: 1.5px solid #333;
      padding: 12px 28px;
    }
    .back {
      transition: transform 0.2s ease;
    }
    .back:hover { text-decoration: none; transform: scale(1.05); }
    .back .back-arrow {
      color: #bbb;
      font-size: 16px;
      transition: color 0.2s ease;
    }
    .back:hover .back-arrow { color: #db634c; }

    .hero-split {
      position: relative;
      width: 100%;
      height: calc(100vh - 80px - 80px);
      max-height: 900px;
      overflow: hidden;
      margin-top: 80px;
    }
    .overview-bar {
      display: flex;
      align-items: center;
      padding: 20px 0 0;
    }
    .overview-bar .meta {
      font-size: 16px;
      font-weight: 600;
      line-height: 28px;
      color: #111;
      margin: 0;
    }
    .hero-right {
      position: absolute;
      left: 0;
      top: 0;
      right: 0;
      height: 100%;
      overflow: hidden;
      z-index: 0;
    }
    .hero-right img {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    @media (min-width: 1600px) {
      .hero-split {
        max-height: 900px;
      }
    }
    .scroll-cue {
      position: absolute;
      bottom: -1px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      background: #fff;
      padding: 0 20px;
      color: #b3b3b3;
      text-decoration: none;
      transition: color 0.3s ease, opacity 0.4s ease;
      z-index: 2;
      white-space: nowrap;
    }
    .scroll-cue:hover { color: #8a8a8a; }
    .scroll-cue__label {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .scroll-cue__arrows {
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 0.55;
      animation: scrollFloat 1.9s ease-in-out infinite;
    }
    .scroll-cue__arrows svg { width: 14px; height: 14px; }
    @keyframes scrollFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(5px); }
    }

    .hero-left {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 0 5% 56px 70px;
      height: 100%;
      width: 45%;
    }
    .hero-num {
      font-size: clamp(80px, 12vw, 160px);
      font-weight: 700;
      color: rgba(0,0,0,0.25);
      line-height: 0.9;
      user-select: none;
      pointer-events: none;
      margin-bottom: 8px;
    }
    .hero-left-content {}

    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px 1.7% 100px;
    }

    .project-title {
      font-size: clamp(28px, 4.5vw, 48px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.3px;
      margin-bottom: 6px;
    }
    .project-subtitle {
      font-size: clamp(18px, 2.5vw, 26px);
      font-weight: 600;
      line-height: 1.2;
      color: #111;
      margin-bottom: 14px;
    }
    .project-tag {
      display: inline-block;
      font-size: 16px;
      font-weight: 600;
      color: #db634c;
      margin-bottom: 28px;
      letter-spacing: 0.01em;
    }
    .divider {
      border: none;
      border-top: 1px solid #e8e8e8;
      margin: 28px 0;
    }
    .meta {
      font-size: 14px;
      font-weight: 600;
      line-height: 1.9;
      color: #111;
      margin-bottom: 36px;
    }
    .body-text p {
      font-size: 16px;
      font-weight: 400;
      line-height: 1.85;
      color: #111;
      text-align: justify;
      margin-bottom: 24px;
    }
    .body-text p:last-child { margin-bottom: 0; }

    .full-img {
      width: 100%;
      height: auto;
      display: block;
      margin-bottom: 0;
    }
    .img-caption {
      text-align: left;
      font-size: 14px;
      font-weight: 300;
      font-style: italic;
      color: #888;
      line-height: 1.5;
      margin-top: 5px;
      margin-bottom: 32px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }
    .grid-2 img { width: 100%; height: auto; display: block; }

    .section-heading {
      font-size: 20px;
      font-weight: 600;
      color: #111;
      margin-top: 64px;
      margin-bottom: 8px;
    }
    .section-label {
      font-size: 14px;
      font-weight: 600;
      color: #db634c;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 28px;
    }
  </style>
</head>
<body>
  <nav class="nav">
    <a class="nav-logo" href="/">SL</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/#projects">Projects</a>
      <a href="#">Research</a>
      <a href="#">About me</a>
      <a href="mailto:sayali03lamne@gmail.com">Contacts</a>
    </div>
  </nav>

  <div class="hero-split">
    <div class="hero-left">
      <span class="hero-num">03</span>
      <div class="hero-left-content">
        <h1 class="project-title">Redefining the Relationship of Humans &amp; their Co-inhabitants through Architecture</h1>
        <span class="project-tag">Graduate Thesis — Application of Sustainable Design Strategies</span>
      </div>
    </div>
    <div class="hero-right">
      <img src="/9.%20Graduate%20Thesis/1.%20museum%20back%20view%20-website.png" alt="Graduate Thesis — Museum Back View" />
    </div>
  </div>

  <div class="overview-bar">
    <div style="position: relative; max-width: 1100px; margin: 0 auto; padding: 0 1.7%; width: 100%; border-bottom: 1px solid #e8e8e8; padding-bottom: 20px;">
      <div class="meta">
        <div>Advisors: Swati Chokshi</div>
        <div>Undergraduate Thesis &nbsp;|&nbsp; B. Arch &nbsp;|&nbsp; Rachana Sansad's Academy of Architecture &nbsp;|&nbsp; 2018</div>
        <div>Location: Kharghar, Mumbai &nbsp;|&nbsp; Project Type: Public</div>
        <div>Tools: Revit, Google Sketchup, AutoCAD</div>
        <div>Type of Work: Individual</div>
      </div>
      <a href="#content" class="scroll-cue" aria-label="Scroll down">
        <span class="scroll-cue__label">Scroll Down</span>
        <span class="scroll-cue__arrows" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    </div>
  </div>

  <div id="content" class="content">

    <div class="body-text">
      <p>The aim of this research study was to design a space, where both humans &amp; their co-inhabitants can interact with each other without the solid barrier of a cage, educate people about their surrounding indigenous species &amp; ecosystem and conserve them.</p>
      <p>This aim to conserve native flora and fauna and bring humans closer to their co-inhabitants in an urban context led to the proposal of a 'Zoological Park'. It gives shelter to all the native non-human species struggling to survive in the wildlife due to various industrial or natural issues. The park was designed in such a way as to merge the adjacent mountain ranges of 'The Western Ghats' and house hundreds of species native to this tropical ecosystem. It also welcomes visitors, which are immersed in natural life and not vice versa.</p>
    </div>

    <h2 class="section-heading" style="display: flex; align-items: center; gap: 12px; margin-top: 64px;"><img src="/9.%20Graduate%20Thesis/Icons/location.png" alt="" style="width: 28px; height: 28px; object-fit: contain;" />Site Context &amp; Challenges</h2>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; align-items: start; margin-top: 48px; margin-bottom: 8px;">
      <div>
        <img class="full-img" src="/9.%20Graduate%20Thesis/Site%20location-h.png" alt="Site Location — Kharghar, Mumbai" style="width: 115%;" />
        <p class="img-caption">Site location: Kharghar, Mumbai</p>
      </div>
      <div>
        <div style="overflow: hidden;">
          <img src="/9.%20Graduate%20Thesis/Site-forming.gif" alt="Site Forming — Water Diversion" style="width: 82%; height: auto; display: block; margin: -10% auto -8%;" />
        </div>
        <p class="img-caption">Water from existing stream was delivered through loops across the site</p>
      </div>
    </div>

    <h2 class="section-heading" style="display: flex; align-items: center; gap: 12px; margin-top: 64px;"><img src="/9.%20Graduate%20Thesis/Icons/hand.png" alt="" style="width: 28px; height: 28px; object-fit: contain;" />Design Proposal</h2>

    <div class="body-text" style="margin-bottom: 48px;">
      <p>The proposal for the zoological park was based on an 'Ex-situ conservation' concept, which is part of the 'Pan-situ conservation' or 'Hybrid conservation' approach. Here animal enrichment is given the highest priority in a way to retain their natural behavior. So, when they are reintroduced back to the wild they can adapt to the environment.</p>
    </div>

    <img class="full-img" src="/9.%20Graduate%20Thesis/SITE%20PLAN_FINAL_CIRCLES_FINAL-latest.jpg" alt="Site Plan" />
    <img class="full-img" src="/9.%20Graduate%20Thesis/Site%20Section%20AA'.jpg" alt="Section AA'" style="margin-top: 8px;" />
    <p class="img-caption">Section AA'</p>

    <h2 class="section-heading" style="display: flex; align-items: center; gap: 12px; margin-top: 64px;"><img src="/9.%20Graduate%20Thesis/Icons/solution.png" alt="" style="width: 28px; height: 28px; object-fit: contain;" />Sustainability Strategies</h2>

    <img class="full-img" src="/9.%20Graduate%20Thesis/AXO_PLANS%20IN%20ONE%20ABOVE%20OTHER.jpg" alt="Axonometric and Floor Plans" />

    <img class="full-img" src="/9.%20Graduate%20Thesis/Rolled%20section.png" alt="Rolled Section" />

    <img class="full-img" src="/9.%20Graduate%20Thesis/00_GROUND_MUSEUM_FINAL-NEW.png" alt="Ground Museum View" style="margin-top: 8px;" />

    <h2 class="section-heading" style="display: flex; align-items: center; gap: 12px; margin-top: 64px;"><img src="/9.%20Graduate%20Thesis/Icons/photo-camera.png" alt="" style="width: 28px; height: 28px; object-fit: contain;" />Construction Details &amp; Architectural Views</h2>

    <img class="full-img" src="/9.%20Graduate%20Thesis/7_DETAILS.jpg" alt="Construction Details" />
    <p class="img-caption">Construction Details</p>

    <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 4px;">
      <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 8px;">
        <img src="/9.%20Graduate%20Thesis/admin%20aerial%20-website.png" alt="Admin Block Aerial View" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        <img src="/9.%20Graduate%20Thesis/Tiger's%20exhibit-website-lower.png" alt="Tiger's Exhibit" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
        <img src="/9.%20Graduate%20Thesis/snake%20front%20view-website.png" alt="Snake Exhibit Front View" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
        <img src="/9.%20Graduate%20Thesis/Elephants'%20bathing%20area-website-lower-min.png" alt="Elephants' Bathing Area" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      </div>
    </div>
    <p class="img-caption">Admin Block and Entrance Pavilion (Top Left), Amphitheater and Snake House (Bottom Left),<br/>Lookout Viewing Trail in Tiger's (Top Right), Elephants' Bathing Area (Bottom Right)</p>

    <div style="margin-top: 64px;">
      <a class="back" href="/projects/computational-design">Back <span class="back-arrow">›</span></a>
    </div>

  </div>
  <script is:inline>
    (function() {
      const el = document.querySelector('.scroll-cue');
      function update() {
        const hidden = window.scrollY > 60;
        el.style.opacity = hidden ? '0' : '1';
        el.style.pointerEvents = hidden ? 'none' : 'auto';
      }
      update();
      window.addEventListener('scroll', update, { passive: true });
    })();
  </script>
</body>
</html>
