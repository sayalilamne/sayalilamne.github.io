<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Passive Strategies for a Sustainable House — Sayali Lamne</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Raleway', sans-serif;
      background: #ffffff;
      color: #111111;
      line-height: 1.6;
    }

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(255,255,255,0.98);
      backdrop-filter: blur(8px);
      box-shadow: 0 1px 12px rgba(0,0,0,0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 80px;
      padding: 24px 130px 24px 70px;
      box-sizing: border-box;
    }
    .nav-logo {
      font-size: 18px;
      font-weight: 700;
      color: #111;
      text-decoration: none;
      letter-spacing: 0.05em;
    }
    .nav-links {
      display: flex;
      gap: 24px;
      margin-left: auto;
    }
    .nav a {
      font-size: 18px;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: #111;
      text-decoration: none;
    }
    .nav a:hover { color: #db634c; }
    .back {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 400;
      color: #333;
      text-decoration: none;
      letter-spacing: 0.02em;
      border: 1.5px solid #333;
      padding: 12px 28px;
    }
    .back {
      transition: transform 0.2s ease;
    }
    .back:hover { text-decoration: none; transform: scale(1.05); }
    .back .back-arrow {
      color: #bbb;
      font-size: 16px;
      transition: color 0.2s ease;
    }
    .back:hover .back-arrow { color: #db634c; }

    .hero-split {
      position: relative;
      width: 100%;
      height: calc(100vh - 80px - 80px);
      max-height: 900px;
      overflow: hidden;
      margin-top: 80px;
    }
    .overview-bar {
      display: flex;
      align-items: center;
      padding: 20px 0 0;
    }
    .overview-bar .meta {
      font-size: 16px;
      font-weight: 600;
      line-height: 28px;
      color: #111;
      margin: 0;
    }
    .hero-right {
      position: absolute;
      left: 0;
      top: 0;
      right: 0;
      height: 100%;
      overflow: hidden;
      z-index: 0;
      background: #ffffff;
    }
    .hero-right img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    @media (min-width: 1600px) {
      .hero-split {
        max-height: 900px;
      }
    }
    .scroll-cue {
      position: absolute;
      bottom: -1px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      background: #fff;
      padding: 0 20px;
      color: #b3b3b3;
      text-decoration: none;
      transition: color 0.3s ease, opacity 0.4s ease;
      z-index: 2;
      white-space: nowrap;
    }
    .scroll-cue:hover { color: #8a8a8a; }
    .scroll-cue__label {
      font-size: 11px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .scroll-cue__arrows {
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 0.55;
      animation: scrollFloat 1.9s ease-in-out infinite;
    }
    .scroll-cue__arrows svg { width: 14px; height: 14px; }
    @keyframes scrollFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(5px); }
    }

    .hero-left {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 0 5% 56px 70px;
      height: 100%;
      width: 45%;
    }
    .hero-num {
      font-size: clamp(80px, 12vw, 160px);
      font-weight: 700;
      color: rgba(0,0,0,0.25);
      line-height: 0.9;
      user-select: none;
      pointer-events: none;
      margin-bottom: 8px;
    }
    .hero-left-content {}

    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px 1.7% 100px;
    }

    .project-title {
      font-size: clamp(28px, 4.5vw, 48px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.3px;
      margin-bottom: 6px;
    }
    .project-subtitle {
      font-size: clamp(18px, 2.5vw, 26px);
      font-weight: 600;
      line-height: 1.2;
      color: #111;
      margin-bottom: 14px;
    }
    .project-tag {
      display: inline-block;
      font-size: 16px;
      font-weight: 600;
      color: #db634c;
      margin-bottom: 28px;
      letter-spacing: 0.01em;
    }
    .divider {
      border: none;
      border-top: 1px solid #e8e8e8;
      margin: 28px 0;
    }
    .meta {
      font-size: 14px;
      font-weight: 600;
      line-height: 1.9;
      color: #111;
      margin-bottom: 36px;
    }
    .body-text p {
      font-size: 16px;
      font-weight: 400;
      line-height: 1.85;
      color: #111;
      text-align: justify;
      margin-bottom: 24px;
    }
    .body-text p:last-child { margin-bottom: 0; }
    .body-text ul {
      font-size: 16px;
      font-weight: 300;
      line-height: 1.85;
      color: #333;
      margin-left: 24px;
      margin-bottom: 24px;
    }
    .body-text ul li { margin-bottom: 6px; }

    .full-img {
      width: 100%;
      height: auto;
      display: block;
      margin-bottom: 0;
    }
    .img-caption {
      text-align: left;
      font-size: 14px;
      font-weight: 300;
      font-style: italic;
      color: #888;
      line-height: 1.5;
      margin-top: 5px;
      margin-bottom: 32px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }
    .grid-2 img { width: 100%; height: auto; display: block; }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 16px;
    }
    .grid-3 img { width: 100%; height: auto; display: block; }

    .section-heading {
      font-size: 20px;
      font-weight: 600;
      color: #111;
      margin-top: 64px;
      margin-bottom: 8px;
    }
    .section-label {
      font-size: 14px;
      font-weight: 600;
      color: #db634c;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 28px;
    }

    /* ── Plan & Sections grid ── */
    .ps-plan-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 32px;
      align-items: start;
    }
    .ps-plan-left img, .ps-plan-right img { width: 100%; height: auto; display: block; }
    .ps-sub-caption {
      font-size: 13px;
      font-weight: 400;
      color: #555;
      text-align: center;
      margin-top: 4px;
      margin-bottom: 8px;
    }

    /* ── Detail rows (drawing + table) ── */
    .ps-detail-row {
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 0 40px;
      align-items: start;
    }
    .ps-detail-left img { width: 100%; height: auto; display: block; }

    /* ── R-value tables ── */
    .ps-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
      margin-top: 8px;
    }
    .ps-table th {
      background: #f7f7f7;
      font-weight: 600;
      color: #111;
      border: 1px solid #d0d0d0;
      padding: 6px 8px;
      text-align: center;
      line-height: 1.4;
    }
    .ps-table th:nth-child(2) { text-align: left; }
    .ps-table td {
      border: 1px solid #d0d0d0;
      padding: 5px 8px;
      font-weight: 300;
      color: #333;
      text-align: center;
      line-height: 1.4;
    }
    .ps-table td:nth-child(2) { text-align: left; }
    .ps-total-row td {
      background: #f7f7f7;
      font-weight: 600;
      font-size: 11px;
      color: #111;
    }

    /* ── R-value summary box ── */
    .ps-rv-box {
      display: flex;
      gap: 16px;
      margin-top: 10px;
      border: 1.5px dashed #d0d0d0;
      padding: 10px 16px;
      width: fit-content;
    }
    .ps-rv-item { display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .ps-rv-label { font-size: 10px; font-weight: 600; color: #888; text-transform: uppercase; letter-spacing: 0.04em; }
    .ps-rv-val { font-size: 15px; font-weight: 700; color: #111; }
    .ps-rv-val.accent { color: #db634c; }

    .ps-sub-label-inline { font-size: 16px; font-weight: 600; color: #db634c; margin-bottom: 10px; }
    .ps-retro-table { width: 100%; border-collapse: collapse; font-size: 11px; }
    .ps-retro-table th { background: #f7f7f7; font-weight: 600; color: #111; border: 1px solid #d0d0d0; padding: 7px 10px; text-align: left; line-height: 1.4; vertical-align: middle; }
    .ps-retro-table td { border: 1px solid #d0d0d0; padding: 6px 10px; font-weight: 300; color: #333; line-height: 1.6; vertical-align: top; }
    .ps-retro-num { text-align: center; font-weight: 600; color: #111; vertical-align: middle !important; width: 28px; }
    .ps-retro-table th:nth-child(4) { width: 120px; }
    .ps-retro-table th:nth-child(5) { width: 140px; }
    .ps-retro-img { width: 140px; padding: 6px !important; vertical-align: middle !important; }
    .ps-retro-img img { width: 128px; height: 128px; object-fit: contain; display: block; }
    /* ── HERS Index ── */
    .ps-hers-section { display: flex; flex-direction: column; align-items: center; gap: 40px; margin-top: 56px; }
    .ps-hers-item { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 640px; }
    .ps-hers-scale-wrap { width: 100%; }
    .ps-hers-labels-top { display: flex; justify-content: space-between; font-size: 10px; font-weight: 600; color: #333; text-align: center; margin-bottom: 4px; }
    .ps-hers-bar-row { display: flex; align-items: center; gap: 4px; }
    .ps-hers-arrow-left { color: #4caf50; font-size: 16px; }
    .ps-hers-arrow-right { color: #e53935; font-size: 16px; }
    .ps-hers-bar {
      flex: 1; height: 18px;
      background: linear-gradient(to right, #1a9e3f, #4caf50, #8bc34a, #cddc39, #ffeb3b, #ffc107, #ff9800, #f44336, #c62828);
      border-radius: 2px;
    }
    .ps-hers-ticks { display: flex; justify-content: space-between; font-size: 9px; color: #555; margin-top: 3px; padding: 0 20px; }
    .ps-hers-100 { font-weight: 700; color: #111; }
    .ps-hers-marker-row { position: relative; height: 56px; padding: 0 20px; }
    .ps-hers-marker-pin { position: absolute; left: var(--hers-pct); transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; }
    .ps-hers-house-icon { font-size: 18px; line-height: 1; }
    .ps-hers-num { font-size: 13px; font-weight: 700; color: #1565c0; line-height: 1.2; }
    .ps-hers-label-small { font-size: 9px; color: #555; white-space: nowrap; }
    .ps-hers-axis-labels { display: flex; justify-content: space-between; font-size: 10px; color: #555; margin-top: 4px; }
    .ps-hers-caption { font-size: 14px; font-weight: 600; color: #db634c; text-align: center; margin-top: 12px; line-height: 1.5; }

    .ps-hl-table td { text-align: center; }
    .ps-hl-table td:nth-child(2) { text-align: center; }
    .ps-total-ua-row td { background: #fff8f7; border: 1px solid #d0d0d0; padding: 8px 12px; font-size: 12px; }
    .ps-peak-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 8px; }
    .ps-peak-table td { border: 1px solid #d0d0d0; padding: 6px 12px; font-weight: 300; color: #333; vertical-align: middle; }
    .ps-peak-label { font-weight: 700; color: #db634c; font-size: 12px; text-align: center; width: 140px; background: #fff8f7; }
    .ps-pie-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
    .ps-pie-item img { width: 100%; height: auto; display: block; }

    @media (max-width: 860px) {
      .grid-3 { grid-template-columns: repeat(2, 1fr); }
      .ps-plan-grid, .ps-detail-row, .ps-pie-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
    }
  </style>
</head>
