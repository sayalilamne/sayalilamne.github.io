  <div class="overview-bar">
    <div style="position: relative; max-width: 1100px; margin: 0 auto; padding: 0 1.7%; width: 100%; border-bottom: 1px solid #e8e8e8; padding-bottom: 20px;">
      <div class="meta">
        <div>Instructor: Vivian Loftness</div>
        <div>Environmental Systems: Climates &amp; Energy in Buildings &nbsp;|&nbsp; (MSSD) Carnegie Mellon University, PA &nbsp;|&nbsp; 2021</div>
