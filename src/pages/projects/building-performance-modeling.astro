    /* ── Section headings ── */
    .section-heading {
      font-size: 20px;
      font-weight: 700;
      color: #db634c;
      margin-top: 64px;
      margin-bottom: 24px;
    }

    /* ── Images ── */
    .full-img {
      width: 100%;
      height: auto;
      display: block;
      margin-bottom: 12px;
    }
    .img-caption {
      text-align: center;
      font-size: 13px;
      font-weight: 300;
      font-style: italic;
      color: #888;
      line-height: 1.5;
      margin-bottom: 32px;
    }

    .grid-2 {
      display: grid;
