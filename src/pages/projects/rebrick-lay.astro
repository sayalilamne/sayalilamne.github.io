  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Raleway', sans-serif;
      background: #ffffff;
      color: #111111;
      line-height: 1.6;
    }

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 80px;
      padding: 24px 130px 24px 70px;
      box-sizing: border-box;
    }
    .nav-logo {
      font-size: 18px;
      font-weight: 700;
      color: #111;
      text-decoration: none;
      letter-spacing: 0.05em;
    }
    .nav-links {
      display: flex;
      gap: 24px;
      margin-left: auto;
    }
    .nav a {
      font-size: 18px;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: #111;
      text-decoration: none;
    }
    .nav a:hover { color: #db634c; }
    .back {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 400;
      color: #333;
      text-decoration: none;
      letter-spacing: 0.02em;
      border: 1.5px solid #333;
      padding: 12px 28px;
    }
    .back {
      transition: transform 0.2s ease;
    }
    .back:hover { text-decoration: none; transform: scale(1.05); }
    .back .back-arrow {
      color: #bbb;
      font-size: 16px;
      transition: color 0.2s ease;
    }
    .back:hover .back-arrow { color: #db634c; }

    .hero-split {
      position: relative;
      width: 100%;
      height: calc(100vh - 80px - 80px);
      max-height: 900px;
      overflow: hidden;
      margin-top: 80px;
    }
    .overview-bar {
      display: flex;
      align-items: center;
      padding: 20px 0 0;
    }
    .overview-bar .meta {
      font-size: 16px;
      font-weight: 600;
      line-height: 28px;
      color: #111;
      margin: 0;
    }
    .hero-right {
      position: absolute;
      left: 0;
      top: 0;
      right: 0;
      height: 100%;
      overflow: hidden;
      z-index: 0;
    }
    .hero-right img {
