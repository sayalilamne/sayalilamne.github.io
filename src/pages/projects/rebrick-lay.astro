    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px 1.7% 100px;
    }

    .project-title {
      font-size: clamp(28px, 4.5vw, 48px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.3px;
      margin-bottom: 6px;
    }
    .project-subtitle {
      font-size: clamp(18px, 2.5vw, 26px);
      font-weight: 600;
      line-height: 1.2;
      color: #111;
      margin-bottom: 14px;
