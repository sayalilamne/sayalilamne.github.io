      font-weight: 400;
      line-height: 1.85;
      color: #111;
      text-align: justify;
      margin-bottom: 24px;
    }
    .body-text p:last-child { margin-bottom: 0; }

    .full-img {
      width: 100%;
      height: auto;
      display: block;
      margin-bottom: 0;
    }
    .img-caption {
      text-align: left;
      font-size: 14px;
      font-weight: 300;
      font-style: italic;
      color: #888;
